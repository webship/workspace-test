{
  "name": "@webship.co/workspace-test",
  "version": "1.0.0-beta2",
  "description": "The Test workspace for Webship Workspace: the `test/` folder (type sites), its settings file, its 34 commands and its docs, activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-test.git"
  },
  "files": [
    "dist/src",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "test",
    "label": "Test",
    "workspace": {
      "key": "test",
      "settingsTemplate": "config/workspace.test.settings.yml",
      "files": [
        "commands/cmd-automated-testing-webship11-0-x-project.sh",
        "commands/cmd-automated-testing-webships3-0-x-project.sh",
        "commands/cmd-claudecodeui-project.sh",
        "commands/cmd-cucumber11-0-x-project.sh",
        "commands/cmd-drupal10-3-x-recommended-project.sh",
        "commands/cmd-drupal10-recommended-project.sh",
        "commands/cmd-drupal11-0-x-recommended-project.sh",
        "commands/cmd-drupal11-4-0-recommended-project.sh",
        "commands/cmd-drupal11-4-x-recommended-project.sh",
        "commands/cmd-drupal11-recommended-project.sh",
        "commands/cmd-drupal12-recommended-project.sh",
        "commands/cmd-drupal9-recommended-project.sh",
        "commands/cmd-drupalcms2-0-project.sh",
        "commands/cmd-drupalcms2-1-0-project.sh",
        "commands/cmd-drupalcms2-x-project.sh",
        "commands/cmd-odoo20-project.sh",
        "commands/cmd-tools-add-users.sh",
        "commands/cmd-tools-backup-test.sh",
        "commands/cmd-tools-cancel-users.sh",
        "commands/cmd-tools-checks.sh",
        "commands/cmd-tools-clone.sh",
        "commands/cmd-tools-hostnames.sh",
        "commands/cmd-tools-reclaim.sh",
        "commands/cmd-tools-remove.sh",
        "commands/cmd-tools-screen.sh",
        "commands/cmd-tools-testing.sh",
        "commands/cmd-tools-update-all.sh",
        "commands/cmd-webship11-0-0-project.sh",
        "commands/cmd-webship11-0-x-project.sh",
        "commands/cmd-webships2-0-0-project.sh",
        "commands/cmd-webships2-0-x-project.sh",
        "commands/cmd-webships3-0-x-project.sh",
        "commands/cmd-wordpress-project.sh",
        "commands/cmd-wpbedrock1-project.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "features": [
      "features/test.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-beta1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
